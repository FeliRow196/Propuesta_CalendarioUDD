# Variables de entorno de Mi Semana. Completa solo las que uses.
# El código no carga un archivo .env por sí solo: defínelas en la terminal antes de ejecutar
# (por ejemplo, en PowerShell: $env:GOOGLE_CLOUD_PROJECT="mi-proyecto"; npm start).
# La app móvil no necesita ninguna: su configuración de Firebase está en mobile/app.json.
# Nunca subas valores reales al repositorio.

# --- Cloud Function de IA (functions/) ---
# Clave de la API de Gemini (Google AI Studio). En producción se guarda como secreto de Firebase:
#   npx firebase-tools functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=

# --- API REST opcional y script de ramos (server/) ---
# ID del proyecto de Firebase (con `gcloud auth application-default login`).
GOOGLE_CLOUD_PROJECT=
# Ruta al .json de una cuenta de servicio (alternativa a la anterior).
GOOGLE_APPLICATION_CREDENTIALS=
# Contenido del .json de la cuenta de servicio, como texto (alternativa a la anterior).
FIREBASE_SERVICE_ACCOUNT=
# Puerto de la API (por defecto 3000).
PORT=
